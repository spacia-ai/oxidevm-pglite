  "type": "module",
  "scripts": {
    "build": "oxidevm wasm build",
    "check": "tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p scripts && eslint . --max-warnings 0 && node scripts/fetch-upstream.ts --verify && oxidevm wasm build --check",
