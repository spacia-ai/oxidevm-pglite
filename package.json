    "test:browser": "node test/browser/run.ts",
    "mutate": "node scripts/mutate.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@eslint/js": "10.0.1",
    "@oxidevm/cli": "0.1.0-alpha.303",
    "@oxidevm/sdk": "0.1.0-alpha.303",
    "@types/emscripten": "1.41.6",
    "@types/node": "24.13.3",
    "eslint": "10.7.0",
    "playwright": "1.61.1",
    "tar": "7.5.22",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "3.2.4"
  }
}
